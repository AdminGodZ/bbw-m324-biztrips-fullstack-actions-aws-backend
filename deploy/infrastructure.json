{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "M324 RefCard03-04 EC2, ECR, ECS, ALB and private RDS; existing Learner Lab roles",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "Subnets": {
      "Type": "List<AWS::EC2::Subnet::Id>"
    },
    "SshCidr": {
      "Type": "String",
      "Description": "SSH source CIDR for deployment runners"
    },
    "AmiId": {
      "Type": "AWS::SSM::Parameter::Value<AWS::EC2::Image::Id>",
      "Default": "/aws/service/ami-amazon-linux-latest/al2023-ami-kernel-default-x86_64"
    }
  },
  "Resources": {
    "Ec2Security": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "M324 EC2 HTTP and SSH",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 22,
            "ToPort": 22,
            "CidrIp": {
              "Ref": "SshCidr"
            }
          }
        ]
      }
    },
    "Ec2": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "ImageId": {
          "Ref": "AmiId"
        },
        "InstanceType": "t3.small",
        "KeyName": "vockey",
        "IamInstanceProfile": "LabInstanceProfile",
        "SubnetId": {
          "Fn::Select": [
            0,
            {
              "Ref": "Subnets"
            }
          ]
        },
        "SecurityGroupIds": [
          {
            "Ref": "Ec2Security"
          }
        ],
        "MetadataOptions": {
          "HttpTokens": "required"
        },
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/xvda",
            "Ebs": {
              "VolumeSize": 12,
              "VolumeType": "gp3",
              "Encrypted": true
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "bbw-m324-biztrips-refcard03-04"
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/usr/bin/env bash\nset -euo pipefail\ndnf install -y java-21-amazon-corretto-headless mariadb105-server nginx rsync openssl\nsystemctl enable --now mariadb\ninstall -d -o ec2-user -g ec2-user /opt/businesstrips /var/lib/biztrips/uploads /var/www/biztrips\nif [[ ! -f /etc/biztrips.env ]]; then\n  db_password=$(openssl rand -hex 24)\n  mariadb <<SQL\nCREATE DATABASE IF NOT EXISTS db_biztrips;\nCREATE USER IF NOT EXISTS 'biztrips'@'localhost' IDENTIFIED BY '$db_password';\nGRANT ALL PRIVILEGES ON db_biztrips.* TO 'biztrips'@'localhost';\nSQL\n  umask 077\n  cat > /etc/biztrips.env <<EOF\nSPRING_PROFILES_ACTIVE=mariadb\nDB_URL=jdbc:mariadb://127.0.0.1:3306/db_biztrips\nDB_USER=biztrips\nDB_PASSWORD=$db_password\nAPP_STORAGE_LOCATION=/var/lib/biztrips/uploads\nEOF\nfi\ncat > /etc/systemd/system/businesstrips.service <<'EOF'\n[Unit]\nDescription=M324 Business Trips RefCard03-04\nAfter=network.target mariadb.service\nRequires=mariadb.service\n[Service]\nUser=ec2-user\nWorkingDirectory=/opt/businesstrips\nEnvironmentFile=/etc/biztrips.env\nExecStart=/usr/bin/java -XX:MaxRAMPercentage=60 -jar /opt/businesstrips/app.jar\nRestart=on-failure\nRestartSec=5\nNoNewPrivileges=true\nPrivateTmp=true\nProtectSystem=strict\nReadWritePaths=/var/lib/biztrips/uploads\n[Install]\nWantedBy=multi-user.target\nEOF\ncat > /etc/nginx/conf.d/biztrips.conf <<'EOF'\nserver {\n  listen 80 default_server;\n  server_name _;\n  root /var/www/biztrips;\n  client_max_body_size 6m;\n  location /v1/ { proxy_pass http://127.0.0.1:8080; }\n  location = /actuator/health { proxy_pass http://127.0.0.1:8080; }\n  location / { try_files $uri $uri/ /index.html; }\n}\nEOF\n# Disable the distribution's competing default virtual host.\nsed -i '/^    server {/,/^    }/d' /etc/nginx/nginx.conf\nprintf '<h1>M324 Business Trips</h1><p>Waiting for the first frontend deployment.</p>' > /var/www/biztrips/index.html\nsystemctl daemon-reload\nnginx -t\nsystemctl enable --now nginx\n"
        }
      }
    },
    "AlbSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "M324 public HTTP ALB",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "TaskSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "M324 tasks only from ALB",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "SourceSecurityGroupId": {
              "Ref": "AlbSecurity"
            }
          },
          {
            "IpProtocol": "tcp",
            "FromPort": 8080,
            "ToPort": 8080,
            "SourceSecurityGroupId": {
              "Ref": "AlbSecurity"
            }
          }
        ]
      }
    },
    "DbSecurity": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "M324 MariaDB only from ECS tasks",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupIngress": [
          {
            "IpProtocol": "tcp",
            "FromPort": 3306,
            "ToPort": 3306,
            "SourceSecurityGroupId": {
              "Ref": "TaskSecurity"
            }
          }
        ]
      }
    },
    "DbSubnets": {
      "Type": "AWS::RDS::DBSubnetGroup",
      "Properties": {
        "DBSubnetGroupDescription": "M324 RDS subnets",
        "SubnetIds": {
          "Ref": "Subnets"
        }
      }
    },
    "DbSecret": {
      "Type": "AWS::SecretsManager::Secret",
      "Properties": {
        "Description": "M324 RDS password",
        "GenerateSecretString": {
          "SecretStringTemplate": "{\"username\":\"biztrips\"}",
          "GenerateStringKey": "password",
          "PasswordLength": 32,
          "ExcludePunctuation": true
        }
      }
    },
    "Database": {
      "Type": "AWS::RDS::DBInstance",
      "Properties": {
        "DBInstanceClass": "db.t3.micro",
        "Engine": "mariadb",
        "AllocatedStorage": "20",
        "StorageType": "gp3",
        "StorageEncrypted": true,
        "DBName": "db_biztrips",
        "MasterUsername": "biztrips",
        "MasterUserPassword": {
          "Fn::Sub": "{{resolve:secretsmanager:${DbSecret}:SecretString:password}}"
        },
        "DBSubnetGroupName": {
          "Ref": "DbSubnets"
        },
        "VPCSecurityGroups": [
          {
            "Ref": "DbSecurity"
          }
        ],
        "PubliclyAccessible": false,
        "BackupRetentionPeriod": 1,
        "MultiAZ": false
      },
      "DeletionPolicy": "Snapshot",
      "UpdateReplacePolicy": "Snapshot"
    },
    "Cluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "bbw-m324-biztrips-refcard03-04",
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "disabled"
          }
        ]
      }
    },
    "BackendEcr": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "bbw-m324-biztrips-refcard03-04-backend",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        }
      }
    },
    "FrontendEcr": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "bbw-m324-biztrips-refcard03-04-frontend",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        }
      }
    },
    "Logs": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/ecs/bbw-m324-biztrips-refcard03-04",
        "RetentionInDays": 7
      }
    },
    "Alb": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Scheme": "internet-facing",
        "Type": "application",
        "Subnets": {
          "Ref": "Subnets"
        },
        "SecurityGroups": [
          {
            "Ref": "AlbSecurity"
          }
        ]
      }
    },
    "BackendTarget": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "TargetType": "ip",
        "Protocol": "HTTP",
        "Port": 8080,
        "HealthCheckPath": "/actuator/health",
        "HealthCheckIntervalSeconds": 15,
        "HealthyThresholdCount": 2,
        "TargetGroupAttributes": [
          {
            "Key": "deregistration_delay.timeout_seconds",
            "Value": "30"
          }
        ]
      }
    },
    "FrontendTarget": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "VpcId": {
          "Ref": "VpcId"
        },
        "TargetType": "ip",
        "Protocol": "HTTP",
        "Port": 80,
        "HealthCheckPath": "/health",
        "HealthCheckIntervalSeconds": 15,
        "HealthyThresholdCount": 2
      }
    },
    "Listener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": {
          "Ref": "Alb"
        },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "FrontendTarget"
            }
          }
        ]
      }
    },
    "ApiRule": {
      "Type": "AWS::ElasticLoadBalancingV2::ListenerRule",
      "Properties": {
        "ListenerArn": {
          "Ref": "Listener"
        },
        "Priority": 10,
        "Conditions": [
          {
            "Field": "path-pattern",
            "Values": [
              "/v1/*",
              "/actuator/health"
            ]
          }
        ],
        "Actions": [
          {
            "Type": "forward",
            "TargetGroupArn": {
              "Ref": "BackendTarget"
            }
          }
        ]
      }
    }
  },
  "Outputs": {
    "Ec2Host": {
      "Value": {
        "Fn::GetAtt": [
          "Ec2",
          "PublicIp"
        ]
      }
    },
    "Endpoint": {
      "Value": {
        "Fn::Sub": "http://${Alb.DNSName}"
      }
    },
    "ClusterName": {
      "Value": {
        "Ref": "Cluster"
      }
    },
    "TaskSecurityGroup": {
      "Value": {
        "Ref": "TaskSecurity"
      }
    },
    "TaskSubnets": {
      "Value": {
        "Fn::Join": [
          ",",
          {
            "Ref": "Subnets"
          }
        ]
      }
    },
    "RoleArn": {
      "Value": {
        "Fn::Sub": "arn:${AWS::Partition}:iam::${AWS::AccountId}:role/LabRole"
      }
    },
    "DBEndpoint": {
      "Value": {
        "Fn::GetAtt": [
          "Database",
          "Endpoint.Address"
        ]
      }
    },
    "DBSecretArn": {
      "Value": {
        "Ref": "DbSecret"
      }
    },
    "BackendEcr": {
      "Value": {
        "Ref": "BackendEcr"
      }
    },
    "FrontendEcr": {
      "Value": {
        "Ref": "FrontendEcr"
      }
    },
    "BackendTarget": {
      "Value": {
        "Ref": "BackendTarget"
      }
    },
    "FrontendTarget": {
      "Value": {
        "Ref": "FrontendTarget"
      }
    },
    "LogGroup": {
      "Value": {
        "Ref": "Logs"
      }
    }
  }
}
